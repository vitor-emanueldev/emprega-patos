// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id        String     @id @default(cuid())
  email     String     @unique
  senha     String?
  nome      String
  googleId  String?    @unique
  fotoUrl   String?
  createdAt DateTime   @default(now())

  candidato Candidato?
  empresa   Empresa?
}

model Candidato {
  id             String    @id @default(cuid())
  nome           String
  telefone       String?
  cpf            String?   @unique
  dataNascimento DateTime?
  habilidades    String[]
  createdAt      DateTime  @default(now())

  fotoUrl String?

  possuiCnh     Boolean?
  categoriaCnh  String?
  possuiVeiculo Boolean?

  cargoDesejado     String?
  areaInteresse     String?
  pretensaoSalarial Float?
  diferencial       String?

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String  @unique

  candidaturas Candidatura[]
  formacoes    CandidatoFormacao[]
  cursos       CandidatoCurso[]
  experiencias CandidatoExperiencia[]
}

model CandidatoFormacao {
  id                String @id @default(cuid())
  nivelEscolaridade String
  instituicao       String
  anoInicio         Int?
  anoConclusao      Int?

  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId String
}

model CandidatoCurso {
  id           String  @id @default(cuid())
  nomeCurso    String
  cargaHoraria String?
  instituicao  String?
  anoConclusao Int?

  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId String
}

model CandidatoExperiencia {
  id         String    @id @default(cuid())
  cargo      String
  empresa    String
  dataInicio DateTime?
  dataFim    DateTime?
  atual      Boolean   @default(false)
  descricao  String?

  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId String
}

model Empresa {
  id          String   @id @default(cuid())
  nomeEmpresa String
  cnpj        String?  @unique
  endereco    String?
  bairro      String?
  setor       String?
  descricao   String?
  telefone    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String  @unique

  vagas Vaga[]
}

model Vaga {
  id                String   @id @default(cuid())
  cargo             String
  descricao         String
  salario           Float?
  endereco          String
  latitude          Float
  longitude         Float
  requisitos        String[]
  responsabilidades String[] @default([])
  beneficios        String[] @default([])
  status            String   @default("aberta")
  tipoContrato      String
  area              String
  bairro            String
  createdAt         DateTime @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId String

  candidaturas Candidatura[]
}

model Candidatura {
  id        String   @id @default(cuid())
  status    String   @default("pendente")
  createdAt DateTime @default(now())

  // Preenchidos quando o empregador aceita ou rejeita a candidatura
  mensagemResposta String?
  dataEntrevista   DateTime?
  respondidoEm     DateTime?

  vaga   Vaga   @relation(fields: [vagaId], references: [id])
  vagaId String

  candidato   Candidato @relation(fields: [candidatoId], references: [id])
  candidatoId String

  @@unique([vagaId, candidatoId])
}

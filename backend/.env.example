# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" NUNCA deve ir para o Git.

# Banco (Supabase) - conexão via pooler e conexão direta (usada nas migrations)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Segredo dos tokens de login. Gere um aleatório e longo (64+ caracteres)
JWT_SECRET=""

# ID do cliente OAuth do Google (o mesmo do frontend)
GOOGLE_CLIENT_ID=""

# Endereço do frontend em produção (pode ter vários, separados por vírgula)
FRONTEND_URL="https://seu-dominio.com"

# Origens extras liberadas no CORS (opcional) - ex: testes pela rede local
CORS_ORIGENS_EXTRAS=""

# Porta do servidor (opcional, padrão 3001). Hospedagens costumam definir sozinhas
PORT=3001

# Coloque "true" somente quando estiver hospedado atrás de um proxy (Render, Railway...)
TRUST_PROXY=false

# Fotos dos candidatos (Supabase Storage). Painel do Supabase → Project Settings → API.
# A service_role é SECRETA: só aqui no backend, NUNCA no frontend.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
